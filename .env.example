# OpenRouter (opcional - exploração funciona sem chave, usando fallback local)
# Nunca versione uma chave real. Configure os valores apenas no .env local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Limite de tokens da resposta narrativa (40-600).
OPENROUTER_MAX_TOKENS=220
# Timeout HTTP em segundos.
OPENROUTER_TIMEOUT=10
# Tempo de vida do cache de descrições, em segundos (0 desativa o cache).
OPENROUTER_CACHE_TTL=21600
# Atraso base do backoff para 429/5xx, em segundos.
OPENROUTER_RETRY_DELAY=1.0
